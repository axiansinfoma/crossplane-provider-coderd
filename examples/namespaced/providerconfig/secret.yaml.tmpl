apiVersion: v1
kind: Secret
metadata:
  name: example-creds
  namespace: crossplane-system
type: Opaque
stringData:
  # The keys mirror the configuration schema of the coderd Terraform provider.
  # "url" and "token" are required; "default_organization_id" and "headers" are
  # optional. The token needs elevated permissions for most resource types.
  credentials: |
    {
      "url": "https://coder.example.com",
      "token": "REPLACE_ME"
    }
